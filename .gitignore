# Nothing generated at runtime belongs in this repo, and two of these files
# hold a Plex token. They live in ~/.config and ~/.cache on the machine that
# was linked; they must never reach a commit.
auth.json
settings.json
favourites.json
pending-pin.json
artists.json
queue.json
queue.m3u
*.token

__pycache__/
*.pyc

# The tag-fix tooling is estate-specific (it names machines and paths); it is
# not part of the published plugin. It lives in its own directory outside this
# repo — `tools` here is at most a local compatibility link to it.
/tools
