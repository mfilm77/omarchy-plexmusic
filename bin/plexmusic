#!/usr/bin/env python3
"""plexmusic — the playback engine behind the Omarchy Plex Music plugin.

Talks to a Plex Media Server over HTTP, keeps a local artist index, and plays
tracks through mpv (direct play, no transcode). The QML plugin shells out to
this; nothing here needs Quickshell, so it is testable on its own.

Everything is JSON on stdout so QML can parse it without a shell pipeline.
"""

from __future__ import annotations

import argparse
import errno
import json
import os
import re
import secrets
import socket
import stat
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config", "omarchy-plex-music")
DATA_DIR = os.path.join(HOME, ".local", "share", "omarchy-plex-music")
AUTH_FILE = os.path.join(CONFIG_DIR, "auth.json")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")
FAVOURITES_FILE = os.path.join(CONFIG_DIR, "favourites.json")
ARTISTS_FILE = os.path.join(DATA_DIR, "artists.json")
TRACKS_FILE = os.path.join(DATA_DIR, "tracks.json")
QUEUE_FILE = os.path.join(DATA_DIR, "queue.json")
PLAYLIST_FILE = os.path.join(DATA_DIR, "queue.m3u")
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"),
    "omarchy-plex-music",
)
ART_DIR = os.path.join(CACHE_DIR, "art")
LOG_FILE = os.path.join(CACHE_DIR, "plexmusic.log")
LOG_LINES = 200
# Where a running index says how far it has got, so the panel can show counts
# going up instead of freezing for the minutes a big library takes.
PROGRESS_FILE = os.path.join(DATA_DIR, "index-progress.json")

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
IPC_SOCKET = os.path.join(RUNTIME_DIR, "omarchy-plexmusic.sock")

PLEX_TV = "https://plex.tv"
PLEX_PRODUCT = "Omarchy Plex Music"
PLEX_VERSION = "0.2.0"
PLEX_PLATFORM = "Linux"

# --------------------------------------------------------------------------- #
# limits
#
# Nothing a server says is trusted to be small. Every response body is capped
# before it is buffered, and the index we hand the shell is bounded in both
# item count and per-string length, so a hostile or broken server cannot make
# the helper or Quickshell eat the machine's memory.
#
# The numbers come from the largest real library this has run against — 66,626
# tracks / 5,167 artists / 10,317 albums — with a wide margin on top:
#   * MAX_JSON_BYTES: the biggest single response is one 5,000-track page of
#     /library/sections/<n>/all — measured at 7.2 MiB against that library.
#     64 MiB is nearly 9x the real worst case and still nothing a desktop
#     would notice.
#   * MAX_ART_BYTES: a 500 px transcoded cover is tens of KB; even an
#     untranscoded original sleeve is a couple of MB. 12 MiB is generous.
#   * MAX_INDEX_ITEMS: 250,000 is ~3.7x the real track count, so a library
#     four times the size of ours still indexes, and a runaway one does not.
#   * MAX_FIELD_CHARS: the longest real title in that library is 250
#     characters, so 512 is twice the worst case seen — room for a long
#     classical title, while a megabyte-long "title" is truncated.
MAX_JSON_BYTES = 64 * 1024 * 1024
MAX_ART_BYTES = 12 * 1024 * 1024
MAX_INDEX_ITEMS = 250_000
MAX_FIELD_CHARS = 512

# Belt and braces for the log: the token travels in a header everywhere, but a
# line that somehow carried one must never reach a file we keep.
TOKEN_IN_TEXT = re.compile(r"X-Plex-Token=[^&\s\"']+")

# No server addresses are baked in. They come from one of two places, in this
# order: addresses the user typed in (settings.json "servers" — that is how a
# Tailscale address gets used, since plex.tv does not advertise tailnet IPs),
# then whatever plex.tv reports for the linked account.


# --------------------------------------------------------------------------- #
# small helpers
# --------------------------------------------------------------------------- #

def die(message: str, code: int = 1) -> "NoReturn":  # type: ignore[name-defined]
    log_failure(message)
    json.dump({"ok": False, "error": message}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(code)


_logging = False


def log_failure(message: str) -> None:
    """Append one line to the failure log, so a bad run leaves a trace.

    The panel shows the reason now, but a panel nobody was looking at used to
    lose it entirely — the first-run indexing bug had to be reconstructed from
    file timestamps because nothing anywhere recorded it.

    The log keeps the last LOG_LINES lines, is written 0600 through the same
    no-follow atomic writer as everything else, and never carries a token: any
    `X-Plex-Token=` value is redacted before the line is stored. Failing to
    write the log is never itself worth failing over, and the `_logging` guard
    stops a write error inside `die()` from recursing.
    """
    global _logging
    if _logging:
        return
    _logging = True
    try:
        line = TOKEN_IN_TEXT.sub("X-Plex-Token=<redacted>", str(message))
        line = line.replace("\n", " ")[:1000]
        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
        old = ""
        try:
            with open(LOG_FILE, "r", encoding="utf-8") as fh:
                old = fh.read()
        except OSError:
            pass
        lines = [l for l in old.splitlines() if l][-(LOG_LINES - 1):]
        lines.append(f"{stamp} {line}")
        atomic_write(LOG_FILE, ("\n".join(lines) + "\n").encode("utf-8"),
                     0o600, fatal=False)
    except Exception:
        pass        # a log we cannot write must never replace the real error
    finally:
        _logging = False


def emit(payload: dict) -> None:
    payload.setdefault("ok", True)
    json.dump(payload, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def index_running(progress: dict) -> bool:
    """Is the indexer in `progress` still alive?

    A progress file outlives the process that wrote it — a killed indexer, a
    machine that lost power mid-scan — so the pid is checked rather than
    trusted, and it has to still be one of ours.
    """
    pid = progress.get("pid")
    if not pid or progress.get("stage") == "done":
        return False
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as fh:
            return b"plexmusic" in fh.read()
    except (OSError, ValueError):
        return False


def read_json(path: str, default):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


class UnsafeState(OSError):
    """The place we were about to write is not one we trust."""


def open_state_dir(path: str, fatal: bool = True) -> int:
    """Open a private directory of ours and return a verified descriptor.

    Everything this program writes — the Plex token in auth.json, the queue
    and playlist whose URLs carry that token, the index — lives in a directory
    that must be ours alone. The final component is opened O_NOFOLLOW, so a
    symlink planted in its place is refused rather than followed, and the
    descriptor is then checked with fstat: a directory, owned by us, with no
    group or other permissions. Loose permissions on a directory we own are
    tightened to 0700 in place (through the descriptor, not the path, so there
    is nothing to swap underneath us); anything else is fatal.

    The caller owns the descriptor and must close it. `fatal` is False for the
    failure log, which must raise rather than print a second answer on stdout
    over the top of the error it was called to record.
    """
    def refuse(reason: str) -> "NoReturn":  # type: ignore[name-defined]
        if fatal:
            die(reason)
        raise UnsafeState(reason)

    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, mode=0o700, exist_ok=True)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.ENOTDIR):
            refuse(f"{path} is not a directory — refusing to write through it")
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            refuse(f"{path} is not a directory — refusing to write through it")
        if st.st_uid != os.getuid():
            refuse(f"{path} is not owned by you — refusing to write through it")
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o700)
            st = os.fstat(fd)
            if st.st_mode & 0o077:
                refuse(f"{path} is not private (mode "
                       f"{stat.S_IMODE(st.st_mode):04o}) — refusing to write")
    except BaseException:
        os.close(fd)
        raise
    return fd


def atomic_write(path: str, data: bytes, mode: int = 0o600,
                 fatal: bool = True) -> None:
    """Replace `path` with `data`, safely, and durably.

    The temporary file is created inside a verified owner-only directory,
    relative to that directory's descriptor, with an unpredictable name and
    O_CREAT|O_EXCL|O_NOFOLLOW — so it cannot be pre-planted as a symlink and
    cannot be guessed and raced. The descriptor is re-checked (regular file,
    ours, one link) before a single byte is written, the data is fsynced
    before the rename, and the directory is fsynced after it. A crash at any
    point leaves either the old file or the new one, never a truncated file
    and never somebody else's file.
    """
    directory, name = os.path.split(path)
    dir_fd = open_state_dir(directory, fatal=fatal)
    tmp = f".{name}.{secrets.token_hex(8)}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     mode, dir_fd=dir_fd)
        try:
            st = os.fstat(fd)
            if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid()
                    or st.st_nlink != 1):
                reason = (f"refusing to write {path}: the temporary file is "
                          "not the private regular file we just created")
                if fatal:
                    die(reason)
                raise UnsafeState(reason)
            os.fchmod(fd, mode)
            written = 0
            while written < len(data):
                written += os.write(fd, data[written:])
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        tmp = ""
        os.fsync(dir_fd)
    finally:
        if tmp:
            try:
                os.unlink(tmp, dir_fd=dir_fd)   # our own temp, nothing else
            except OSError:
                pass
        os.close(dir_fd)


def write_json(path: str, data, mode: int = 0o600) -> None:
    blob = json.dumps(data, ensure_ascii=False, indent=2) + "\n"
    atomic_write(path, blob.encode("utf-8"), mode)


class ResponseTooLarge(Exception):
    """A server sent more than we are willing to hold in memory."""


def read_capped(resp, cap: int, what: str = "response") -> bytes:
    """Read a response body, refusing anything over `cap` bytes.

    Content-Length is checked first, so an oversized body is rejected before
    it is fetched at all — but it is only a hint, so the cap is enforced again
    while streaming. A chunked or lying server gets no further than cap + 1
    bytes into our memory.
    """
    declared = resp.headers.get("Content-Length")
    if declared is not None:
        try:
            if int(declared) > cap:
                raise ResponseTooLarge(
                    f"{what} declares {int(declared)} bytes, over the "
                    f"{cap} byte limit")
        except ValueError:
            pass
    buf = bytearray()
    while True:
        chunk = resp.read(min(65536, cap + 1 - len(buf)))
        if not chunk:
            break
        buf += chunk
        if len(buf) > cap:
            raise ResponseTooLarge(
                f"{what} is over the {cap} byte limit")
    return bytes(buf)


def bounded_text(value, limit: int = MAX_FIELD_CHARS) -> str:
    """A string short enough to publish to the shell."""
    text = str(value or "")
    return text[:limit] if len(text) > limit else text


def bounded_int(value, default: int = 0) -> int:
    """An integer field from a server reply, or the default if it is junk."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def fold(text: str) -> str:
    """Case- and accent-insensitive key for matching artist names."""
    stripped = unicodedata.normalize("NFKD", text)
    # Drop combining marks (accents) and invisible characters. A byte-order
    # mark or zero-width space at the front of a tag is common in old rips
    # and would otherwise file "Evil Nine" under the symbol block twice.
    stripped = "".join(
        c for c in stripped
        if not unicodedata.combining(c) and unicodedata.category(c) != "Cf")
    return stripped.casefold()


def art_cache_path(thumb: str, size: int) -> str:
    """Where a Plex thumb is cached at a given size.

    Plex thumb paths end in a version number, so the cache key changes when
    the artwork changes and stale covers cannot stick around. Anything that is
    not a plain filename character is flattened, so a thumb can never name a
    file outside the cache directory.
    """
    slug = thumb.strip("/").replace("/", "_")
    slug = "".join(c if c.isalnum() or c in "._-" else "_" for c in slug)
    return os.path.join(ART_DIR, f"{slug.lstrip('.') or 'art'}_{size}.jpg")


def art_file_url(path: str | None) -> str:
    """A file:// URL for QML's Image, or "" when there is no cover."""
    if not path:
        return ""
    return "file://" + urllib.parse.quote(os.path.abspath(path))


# --------------------------------------------------------------------------- #
# Plex
# --------------------------------------------------------------------------- #

def client_identifier() -> str:
    """A stable per-install id. Created on first use, never shipped."""
    auth = read_json(AUTH_FILE, {})
    cid = auth.get("clientIdentifier")
    if not cid:
        import uuid
        cid = str(uuid.uuid4())
        auth["clientIdentifier"] = cid
        write_json(AUTH_FILE, auth)
    return cid


def plex_tv_headers(client_id: str, token: str | None = None) -> dict:
    headers = {
        "Accept": "application/json",
        "X-Plex-Product": PLEX_PRODUCT,
        "X-Plex-Version": PLEX_VERSION,
        "X-Plex-Platform": PLEX_PLATFORM,
        "X-Plex-Device": "Omarchy",
        "X-Plex-Client-Identifier": client_id,
    }
    if token:
        headers["X-Plex-Token"] = token
    return headers


def plex_tv_request(path: str, client_id: str, token: str | None = None,
                    method: str = "GET", timeout: float = 20.0) -> dict:
    req = urllib.request.Request(
        PLEX_TV + path, headers=plex_tv_headers(client_id, token), method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = read_capped(resp, MAX_JSON_BYTES, "plex.tv " + path)
    if not raw:
        return {}
    return json.loads(raw.decode("utf-8", errors="replace"))


class Plex:
    def __init__(self) -> None:
        auth = read_json(AUTH_FILE, {})
        self.token = auth.get("authToken")
        self.client_id = auth.get("clientIdentifier") or "omarchy-plex-music"
        if not self.token:
            die("not linked to Plex — run `plexmusic link` first", code=2)
        self.settings = read_json(SETTINGS_FILE, {})
        self.base = self.settings.get("baseUrl")
        self.section = str(self.settings.get("musicSection") or "")

    # -- transport ---------------------------------------------------------- #

    def headers(self) -> dict:
        return {
            "X-Plex-Token": self.token,
            "X-Plex-Client-Identifier": self.client_id,
            "X-Plex-Product": PLEX_PRODUCT,
            "X-Plex-Version": PLEX_VERSION,
            "Accept": "application/json",
        }

    def get(self, path: str, params: dict | None = None, base: str | None = None,
            timeout: float = 15.0) -> dict:
        base = base or self.resolve_base()
        url = base + path
        if params:
            url += ("&" if "?" in path else "?") + urllib.parse.urlencode(params)
        req = urllib.request.Request(url, headers=self.headers())
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = read_capped(resp, MAX_JSON_BYTES, path)
        # This library is full of old rips whose tags are not valid UTF-8, and
        # Plex hands those bytes straight back. Replace rather than crash — one
        # mangled character in one artist name must not kill the whole index.
        return json.loads(raw.decode("utf-8", errors="replace"))

    def reachable(self, base: str, timeout: float = 2.5) -> float | None:
        """Return round-trip seconds if this server answers, else None."""
        req = urllib.request.Request(base + "/identity", headers=self.headers())
        start = time.monotonic()
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                if resp.status == 200:
                    return time.monotonic() - start
        except Exception:
            return None
        return None

    def discover(self) -> list[dict]:
        """Every address we could try, best-first, with where it came from.

        Manually configured addresses win, because that is the only way a
        Tailscale address can be used — plex.tv never advertises tailnet IPs.
        """
        candidates: list[dict] = []
        seen: set[str] = set()

        def add(uri: str, source: str, name: str = "", local: bool = False,
                relay: bool = False) -> None:
            uri = (uri or "").rstrip("/")
            if not uri or uri in seen:
                return
            seen.add(uri)
            candidates.append({"uri": uri, "source": source, "name": name,
                               "local": local, "relay": relay})

        for uri in self.settings.get("servers") or []:
            add(uri, "manual", local=True)

        try:
            resources = plex_tv_request(
                "/api/v2/resources?includeHttps=1&includeRelay=1",
                self.client_id, self.token)
        except Exception:
            resources = []
        if isinstance(resources, list):
            direct, relayed = [], []
            for dev in resources:
                if "server" not in (dev.get("provides") or ""):
                    continue
                name = dev.get("name") or ""
                for conn in dev.get("connections") or []:
                    entry = (conn.get("uri"), name, bool(conn.get("local")),
                             bool(conn.get("relay")))
                    (relayed if conn.get("relay") else direct).append(entry)
            # Local addresses before remote, and Plex's slow relay dead last.
            direct.sort(key=lambda e: not e[2])
            for uri, name, local, relay in direct + relayed:
                add(uri, "plex.tv", name, local, relay)
        return candidates

    def resolve_base(self, force: bool = False) -> str:
        """Pick a server that actually answers, preferring the cached one."""
        if self.base and not force and self.reachable(self.base) is not None:
            return self.base
        for cand in self.discover():
            if self.reachable(cand["uri"]) is not None:
                self.base = cand["uri"]
                self.settings["baseUrl"] = cand["uri"]
                write_json(SETTINGS_FILE, self.settings)
                return cand["uri"]
        die("no Plex server reachable — add an address with "
            "`plexmusic server --add http://host:32400`", code=3)

    # -- library ------------------------------------------------------------ #

    def find_music_section(self, required: bool = True) -> str:
        """The key of the music library, or "" when `required` is False.

        `required` exists so that pinning a server can quietly pick a section
        without a server that has no music library turning into a fatal error
        on an otherwise perfectly good `server --use`.
        """
        data = self.get("/library/sections")
        for d in data.get("MediaContainer", {}).get("Directory", []):
            if d.get("type") == "artist" and d.get("title", "").lower() == "music":
                return str(d.get("key"))
        # No section literally called Music — take the first artist section.
        for d in data.get("MediaContainer", {}).get("Directory", []):
            if d.get("type") == "artist":
                return str(d.get("key"))
        if not required:
            return ""
        die("no music (artist) library section found on this Plex server")

    def all_artists(self, page: int = 1000, on_progress=None) -> list[dict]:
        artists: list[dict] = []
        start = 0
        while True:
            data = self.get(
                f"/library/sections/{self.section}/all",
                {"type": 8, "X-Plex-Container-Start": start,
                 "X-Plex-Container-Size": page},
            )
            container = data.get("MediaContainer", {})
            batch = container.get("Metadata") or []
            for m in batch:
                title = bounded_text(m.get("title")) or "<unknown>"
                # Plex's own sort key already drops a leading "The", so the
                # A-Z browse files The Beatles under B, as a record shop does.
                # The letter must come from the key's FIRST character, not the
                # first letter in it: Plex puts "!Deladap" in the symbol block
                # at the top, and labelling it D would break the A-Z order.
                sort_key = fold(m.get("titleSort") or title).lstrip()
                first = sort_key[:1] or "#"
                artists.append({
                    "key": bounded_text(m.get("ratingKey")),
                    "title": title,
                    "thumb": bounded_text(m.get("thumb")),
                    "albums": bounded_int(m.get("childCount")),
                    # Pre-folded so the panel can search in QML without a
                    # process per keystroke, and without needing Unicode
                    # normalisation in the QML engine.
                    "fold": fold(title),
                    # A-Z only; digits and non-Latin initials file under #.
                    "letter": first.upper() if "a" <= first <= "z" else "#",
                })
            total = container.get("totalSize", len(artists))
            start += len(batch)
            if on_progress:
                on_progress(len(artists), bounded_int(total))
            if len(artists) > MAX_INDEX_ITEMS:
                die(f"this library reports more than {MAX_INDEX_ITEMS} artists "
                    "— refusing to build an index that large")
            if not batch or start >= total:
                break
        return artists

    def machine_id(self) -> str:
        cached = self.settings.get("machineIdentifier")
        if cached:
            return cached
        ident = self.get("/identity")
        mid = ident.get("MediaContainer", {}).get("machineIdentifier", "")
        if mid:
            self.settings["machineIdentifier"] = mid
            write_json(SETTINGS_FILE, self.settings)
        return mid

    def attach_art(self, items: list[dict], size: int,
                   thumb_field: str = "thumb") -> None:
        """Give every item an `artUrl` that is a local file:// URL, never a
        Plex URL. The token must not reach QML: a failed network image load
        prints its whole URL into the user journal. Covers are fetched into
        the cache here, a few at a time; one that cannot be fetched gets ""
        and the panel shows its glyph instead.
        """
        wanted = {it.get(thumb_field) or "" for it in items} - {""}
        found: dict[str, str | None] = {}
        misses = []
        for thumb in wanted:
            path = art_cache_path(thumb, size)
            if os.path.exists(path) and os.path.getsize(path) > 0:
                found[thumb] = path
            else:
                misses.append(thumb)
        if misses:
            from concurrent.futures import ThreadPoolExecutor
            with ThreadPoolExecutor(max_workers=8) as pool:
                for thumb, path in zip(misses, pool.map(
                        lambda t: self.art_path(t, size=size), misses)):
                    found[thumb] = path
        for it in items:
            it["artUrl"] = art_file_url(found.get(it.get(thumb_field) or ""))

    def artist_albums(self, rating_key: str) -> list[dict]:
        data = self.get(f"/library/metadata/{rating_key}/children")
        albums: list[dict] = []
        for m in data.get("MediaContainer", {}).get("Metadata", []) or []:
            if m.get("type") != "album":
                continue
            thumb = m.get("thumb") or m.get("parentThumb") or ""
            albums.append({
                "key": str(m.get("ratingKey")),
                "title": m.get("title") or "",
                "year": m.get("year") or 0,
                # Neither leafCount nor childCount is in this listing; the
                # per-album metadata has it and is one small request each.
                "tracks": m.get("leafCount") or m.get("childCount") or self.album_track_count(str(m.get("ratingKey"))),
                "thumb": thumb,
            })
        # Newest first, as a discography is usually read.
        albums.sort(key=lambda a: (-(a["year"] or 0), a["title"].lower()))
        self.attach_art(albums, 160)
        return albums

    def album_track_count(self, album_key: str) -> int:
        try:
            data = self.get(f"/library/metadata/{album_key}")
            items = data.get("MediaContainer", {}).get("Metadata", []) or []
            return int(items[0].get("leafCount") or items[0].get("childCount") or 0) if items else 0
        except Exception:
            return 0

    def playlists(self) -> list[dict]:
        data = self.get("/playlists", {"playlistType": "audio"})
        out: list[dict] = []
        for m in data.get("MediaContainer", {}).get("Metadata", []) or []:
            if m.get("smart"):
                # Smart playlists are rules, not lists; nothing can be added.
                continue
            out.append({
                "key": str(m.get("ratingKey")),
                "title": m.get("title") or "",
                "tracks": m.get("leafCount") or 0,
                "duration": int(m.get("duration") or 0),
                "thumb": m.get("composite") or "",
            })
        out.sort(key=lambda p: p["title"].lower())
        self.attach_art(out, 160)
        return out

    def playlist_create(self, title: str, track_keys: list[str]) -> dict:
        uri = self.library_uri(track_keys)
        query = urllib.parse.urlencode(
            {"type": "audio", "title": title, "smart": 0, "uri": uri})
        req = urllib.request.Request(
            (self.base or self.resolve_base()) + "/playlists?" + query,
            headers=self.headers(), method="POST")
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = read_capped(resp, MAX_JSON_BYTES, "playlist response")
        data = json.loads(raw.decode("utf-8", errors="replace")) if raw else {}
        items = data.get("MediaContainer", {}).get("Metadata", []) or []
        return {"key": str(items[0].get("ratingKey")) if items else "",
                "title": title}

    def playlist_add(self, playlist_key: str, track_keys: list[str]) -> int:
        uri = self.library_uri(track_keys)
        query = urllib.parse.urlencode({"uri": uri})
        req = urllib.request.Request(
            (self.base or self.resolve_base())
            + f"/playlists/{playlist_key}/items?" + query,
            headers=self.headers(), method="PUT")
        with urllib.request.urlopen(req, timeout=20) as resp:
            raw = read_capped(resp, MAX_JSON_BYTES, "playlist response")
        data = json.loads(raw.decode("utf-8", errors="replace")) if raw else {}
        return int(data.get("MediaContainer", {}).get("leafCountAdded") or 0)

    def library_uri(self, track_keys: list[str]) -> str:
        keys = ",".join(str(k) for k in track_keys if k)
        return (f"server://{self.machine_id()}/com.plexapp.plugins.library"
                f"/library/metadata/{keys}")

    def tracks_at(self, path: str) -> list[dict]:
        """Playable tracks under any Plex path that lists track metadata."""
        data = self.get(path)
        tracks: list[dict] = []
        for m in data.get("MediaContainer", {}).get("Metadata", []) or []:
            if m.get("type") not in (None, "track"):
                continue
            part = None
            for media in m.get("Media", []) or []:
                for p in media.get("Part", []) or []:
                    if p.get("key"):
                        part = p
                        break
                if part:
                    break
            if not part:
                continue
            tracks.append({
                "key": bounded_text(m.get("ratingKey")),
                "title": bounded_text(m.get("title")),
                "album": bounded_text(m.get("parentTitle")),
                "artist": bounded_text(
                    m.get("grandparentTitle") or m.get("originalTitle")),
                "index": bounded_int(m.get("index")),
                "disc": bounded_int(m.get("parentIndex"), default=1),
                "duration": bounded_int(m.get("duration")),
                "part": bounded_text(part["key"], 4096),
                # The vinyl label art. Album cover first, artist shot as the
                # fallback — 94% of albums here have a cover, 83% of artists do.
                "albumKey": bounded_text(m.get("parentRatingKey")),
                "albumThumb": bounded_text(
                    m.get("parentThumb") or m.get("grandparentThumb")),
                # So the panel can open the playing track's album and artist
                # by key, never by searching for a name.
                "artistKey": bounded_text(m.get("grandparentRatingKey")),
                "albumYear": bounded_int(m.get("parentYear")),
            })
        return tracks

    def all_tracks(self, page: int = 5000, on_progress=None) -> list[dict]:
        """Every track, slim — the song search index.

        Plex does not return these in any order we can rely on (a fresh index
        starts #, Y, L), so nothing downstream may assume one: the panel folds
        and sorts client-side, and the A-Z strip is built from the `letter`
        field rather than from position.
        """
        out: list[dict] = []
        start = 0
        # How many rows Plex said it had, and how many we dropped for having no
        # title at all. Reported by `index` so a gap between the two is visible
        # rather than something to work out from the file afterwards.
        self.track_total = 0
        self.track_skipped = 0
        while True:
            data = self.get(
                f"/library/sections/{self.section}/all",
                {"type": 10, "X-Plex-Container-Start": start,
                 "X-Plex-Container-Size": page})
            container = data.get("MediaContainer", {})
            batch = container.get("Metadata") or []
            self.track_total = max(self.track_total,
                                   bounded_int(container.get("totalSize")))
            for m in batch:
                title = bounded_text(m.get("title"))
                if not title:
                    self.track_skipped += 1
                    continue
                sort_key = fold(m.get("titleSort") or title).lstrip()
                first = sort_key[:1] or "#"
                out.append({
                    "key": bounded_text(m.get("ratingKey")),
                    "title": title,
                    "artist": bounded_text(m.get("grandparentTitle")),
                    "album": bounded_text(m.get("parentTitle")),
                    "albumKey": bounded_text(m.get("parentRatingKey")),
                    "artistKey": bounded_text(m.get("grandparentRatingKey")),
                    "duration": bounded_int(m.get("duration")),
                    "thumb": bounded_text(m.get("parentThumb")),
                    "fold": fold(title),
                    "letter": first.upper() if "a" <= first <= "z" else "#",
                })
            total = container.get("totalSize", len(out))
            start += len(batch)
            if on_progress:
                on_progress(len(out), self.track_total or bounded_int(total))
            if len(out) > MAX_INDEX_ITEMS:
                die(f"this library reports more than {MAX_INDEX_ITEMS} tracks "
                    "— refusing to build an index that large")
            if not batch or start >= total:
                break
        return out

    def artist_tracks(self, rating_key: str) -> list[dict]:
        return self.tracks_at(f"/library/metadata/{rating_key}/allLeaves")

    def album_tracks(self, rating_key: str) -> list[dict]:
        return self.tracks_at(f"/library/metadata/{rating_key}/children")

    def playlist_tracks(self, rating_key: str) -> list[dict]:
        return self.tracks_at(f"/playlists/{rating_key}/items")

    def tracks_by_keys(self, keys: list[str]) -> list[dict]:
        return self.tracks_at("/library/metadata/" + ",".join(keys))

    def stream_url(self, part_key: str) -> str:
        base = self.base or self.resolve_base()
        return f"{base}{part_key}?X-Plex-Token={urllib.parse.quote(self.token)}"

    # -- artwork ------------------------------------------------------------ #

    def art_path(self, thumb: str, size: int = 500) -> str | None:
        """Cache a Plex thumb locally and return its path. None if no art."""
        if not thumb:
            return None
        target = art_cache_path(thumb, size)
        if os.path.exists(target) and os.path.getsize(target) > 0:
            return target
        base = self.base or self.resolve_base()
        # The token travels in the request header only, so this URL holds
        # nothing secret even if an exception or a log line ever shows it.
        query = urllib.parse.urlencode({
            "width": size, "height": size, "minSize": 1, "upscale": 1,
            "url": thumb,
        })
        url = f"{base}/photo/:/transcode?{query}"
        try:
            req = urllib.request.Request(url, headers=self.headers())
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = read_capped(resp, MAX_ART_BYTES, "artwork")
            if not data:
                return None
            # Same safe writer as every other file: verified private dir,
            # unpredictable O_EXCL|O_NOFOLLOW temp, fsync, atomic rename. It
            # cleans up its own temp file if anything above fails.
            atomic_write(target, data, 0o600)
            return target
        except Exception:
            return None


# --------------------------------------------------------------------------- #
# mpv
# --------------------------------------------------------------------------- #

def mpv_request(command: list, timeout: float = 1.5):
    """Send one IPC command to a running mpv. Returns None if mpv is not up."""
    if not os.path.exists(IPC_SOCKET):
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(IPC_SOCKET)
            sock.sendall((json.dumps({"command": command}) + "\n").encode("utf-8"))
            buffer = b""
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buffer += chunk
                for line in buffer.split(b"\n"):
                    if not line.strip():
                        continue
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    # Ignore async events; we want the reply to our command.
                    if "error" in msg:
                        return msg
                if buffer.endswith(b"\n"):
                    break
    except (OSError, socket.timeout):
        return None
    return None


def mpv_get(prop: str):
    reply = mpv_request(["get_property", prop])
    if reply and reply.get("error") == "success":
        return reply.get("data")
    return None


def mpv_running() -> bool:
    return mpv_get("idle-active") is not None or mpv_get("pid") is not None


def mpv_stop() -> None:
    mpv_request(["quit"])
    for _ in range(20):
        if not os.path.exists(IPC_SOCKET):
            return
        time.sleep(0.05)
    try:
        os.unlink(IPC_SOCKET)
    except OSError:
        pass


def mpv_launch(playlist_path: str, shuffle: bool, start_index: int = 0,
               loop: bool = False) -> None:
    mpv_stop()
    args = [
        "mpv",
        "--no-video",
        "--audio-display=no",
        "--gapless-audio=yes",
        "--no-terminal",
        "--idle=no",
        "--force-window=no",
        f"--input-ipc-server={IPC_SOCKET}",
        f"--playlist={playlist_path}",
        # Plex serves the original file untouched — direct play, no transcode.
        "--cache=yes",
        "--demuxer-max-bytes=64MiB",
        # Levels out a library ripped over 20 years. A no-op on files with no
        # ReplayGain tags, which is most of an old collection.
        "--replaygain=track",
    ]
    if shuffle:
        args.append("--shuffle")
    if start_index > 0:
        # Start partway through the queue while keeping the whole of it, so
        # position N of M is really N of M and "previous" can go back.
        args.append(f"--playlist-start={start_index}")
    if loop:
        args.append("--loop-playlist=inf")
    # Escape hatch for output device, replaygain mode, filters, etc.
    extra = os.environ.get("PLEXMUSIC_MPV_ARGS", "").strip()
    if extra:
        import shlex
        args.extend(shlex.split(extra))
    subprocess.Popen(
        args,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #

PENDING_PIN_FILE = os.path.join(DATA_DIR, "pending-pin.json")


def cmd_link(args) -> None:
    """The plex.tv link flow: show a 4-character code, then poll for a token.

    Nothing but the user's own browser ever sees their Plex password.
    """
    cid = client_identifier()

    if args.action == "start":
        pin = plex_tv_request("/api/v2/pins", cid, method="POST")
        if not pin.get("code"):
            die("Plex did not issue a link code")
        write_json(PENDING_PIN_FILE, {"id": pin["id"], "code": pin["code"],
                                      "expiresAt": pin.get("expiresAt")})
        emit({"code": pin["code"], "pinId": pin["id"],
              "url": "https://plex.tv/link", "expiresAt": pin.get("expiresAt")})
        return

    if args.action == "poll":
        pending = read_json(PENDING_PIN_FILE, {})
        if not pending.get("id"):
            die("no link in progress — run `plexmusic link start` first")
        result = plex_tv_request(f"/api/v2/pins/{pending['id']}", cid)
        token = result.get("authToken")
        if not token:
            emit({"linked": False, "code": pending.get("code"),
                  "expiresAt": pending.get("expiresAt")})
            return
        auth = read_json(AUTH_FILE, {})
        auth.update({"authToken": token, "clientIdentifier": cid,
                     "product": PLEX_PRODUCT, "linkedAt": int(time.time())})
        write_json(AUTH_FILE, auth)
        try:
            os.unlink(PENDING_PIN_FILE)
        except OSError:
            pass
        emit({"linked": True})
        return

    if args.action == "status":
        auth = read_json(AUTH_FILE, {})
        emit({"linked": bool(auth.get("authToken")),
              "linkedAt": auth.get("linkedAt")})
        return

    if args.action == "forget":
        # Wipe every trace of the account from this machine.
        for path in (AUTH_FILE, PENDING_PIN_FILE, SETTINGS_FILE,
                     ARTISTS_FILE, TRACKS_FILE, QUEUE_FILE, PLAYLIST_FILE,
                     PROGRESS_FILE):
            try:
                os.unlink(path)
            except OSError:
                pass
        emit({"linked": False, "forgotten": True})
        return

    die(f"unknown link action: {args.action}")


def cmd_server(args) -> None:
    """List, add, remove or pin the Plex address.

    The manual path matters for anyone whose server is not where plex.tv
    thinks it is: a VPN address, a reverse proxy, a LAN name.
    """
    settings = read_json(SETTINGS_FILE, {})
    servers = settings.get("servers") or []

    def normalise(uri: str) -> str:
        uri = (uri or "").strip().rstrip("/")
        if uri and "://" not in uri:
            uri = "http://" + uri
        if uri.count(":") == 1:              # scheme only, no port given
            uri += ":32400"
        return uri

    if args.add or args.use:
        uri = normalise(args.add or args.use)
        if not uri.startswith(("http://", "https://")):
            die("address must look like http://host:32400")
        plex = Plex()
        rtt = plex.reachable(uri, timeout=4.0)
        if uri not in servers:
            servers.insert(0, uri)
        settings["servers"] = servers
        if rtt is not None:
            # Pin it: this is now the address, until it stops answering.
            settings["baseUrl"] = uri
            # And choose the music library straight away. Without this, someone
            # who links the account and only then adds the server ends up with
            # a linked, reachable, correctly configured plugin and a
            # permanently empty library: the index attempt that fires after
            # linking had no address yet, and adding one never set a section or
            # tried again.
            if not settings.get("musicSection"):
                try:
                    plex.base = uri
                    plex.settings = settings
                    section = plex.find_music_section(required=False)
                    if section:
                        settings["musicSection"] = section
                except Exception:
                    pass                  # the panel can still pick one by hand
        elif settings.get("baseUrl") == uri:
            settings.pop("baseUrl", None)
        write_json(SETTINGS_FILE, settings)
        emit({"servers": servers, "active": settings.get("baseUrl"),
              "added": uri, "reachable": rtt is not None,
              "section": settings.get("musicSection") or "",
              "ms": round(rtt * 1000, 1) if rtt is not None else None})
        return

    if args.remove:
        servers = [s for s in servers if s.rstrip("/") != args.remove.rstrip("/")]
        settings["servers"] = servers
        settings.pop("baseUrl", None)
        write_json(SETTINGS_FILE, settings)
        emit({"servers": servers})
        return

    plex = Plex()
    found = plex.discover()
    # Probe every candidate at once. plex.tv can list eight addresses for one
    # server, most of them dead from where you sit; in series that is a
    # sixteen-second wait for a settings page.
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=max(1, min(12, len(found)))) as pool:
        rtts = list(pool.map(lambda c: plex.reachable(c["uri"], timeout=2.0), found))
    for cand, rtt in zip(found, rtts):
        cand["reachable"] = rtt is not None
        cand["ms"] = round(rtt * 1000, 1) if rtt is not None else None
    emit({"servers": found, "active": settings.get("baseUrl")})


def cmd_account(args) -> None:
    """Who is linked, from plex.tv. The username is cached; nothing else is."""
    auth = read_json(AUTH_FILE, {})
    if not auth.get("authToken"):
        emit({"linked": False})
        return
    try:
        user = plex_tv_request("/api/v2/user", auth.get("clientIdentifier", ""),
                               auth["authToken"])
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            # The token has been revoked from the Plex side.
            emit({"linked": True, "valid": False, "username": auth.get("username", "")})
            return
        raise
    username = user.get("username") or user.get("title") or ""
    if username and username != auth.get("username"):
        auth["username"] = username
        write_json(AUTH_FILE, auth)
    emit({"linked": True, "valid": True, "username": username,
          "title": user.get("title") or username})


def cmd_sections(args) -> None:
    """The music libraries on the server; pick which one the plugin indexes."""
    plex = Plex()
    plex.resolve_base()
    if args.use:
        plex.settings["musicSection"] = str(args.use)
        write_json(SETTINGS_FILE, plex.settings)
        # The index belongs to the old section; it is rebuilt on demand.
        for path in (ARTISTS_FILE, TRACKS_FILE):
            try:
                os.unlink(path)
            except OSError:
                pass
    data = plex.get("/library/sections")
    out = []
    for d in data.get("MediaContainer", {}).get("Directory", []) or []:
        if d.get("type") != "artist":
            continue
        out.append({"key": str(d.get("key")), "title": d.get("title") or "",
                    "active": str(d.get("key")) == str(plex.settings.get("musicSection") or "")})
    emit({"sections": out, "active": plex.settings.get("musicSection")})


def cmd_art(args) -> None:
    plex = Plex()
    plex.resolve_base()
    path = plex.art_path(args.thumb, size=args.size)
    if not path:
        die("no artwork available for that item")
    emit({"path": path})


def cmd_status(args) -> None:
    auth = read_json(AUTH_FILE, {})
    settings = read_json(SETTINGS_FILE, {})
    index = read_json(ARTISTS_FILE, {})
    # When did Plex last scan the music library? If that is newer than our
    # index, the panel rebuilds the index on its own — new music shows up
    # without anyone pressing Rescan.
    scanned_at = None
    if auth.get("authToken") and settings.get("baseUrl") and settings.get("musicSection"):
        try:
            plex = Plex()
            data = plex.get("/library/sections", timeout=4)
            for d in data.get("MediaContainer", {}).get("Directory", []) or []:
                if str(d.get("key")) == str(settings.get("musicSection")):
                    scanned_at = max(int(d.get("scannedAt") or 0), int(d.get("updatedAt") or 0))
        except Exception:
            scanned_at = None
    payload = {
        "linked": bool(auth.get("authToken")),
        "server": settings.get("baseUrl"),
        "section": settings.get("musicSection"),
        "artistCount": len(index.get("artists", [])),
        "indexedAt": index.get("indexedAt"),
        "libraryScannedAt": scanned_at,
        "favourites": len(read_json(FAVOURITES_FILE, {"items": []}).get("items", [])),
        "playing": mpv_running(),
    }
    emit(payload)


def cmd_index(args) -> None:
    # One indexer at a time. The panel guards this too, but a shell restart
    # loses that flag, and two indexers would fight over the same files and
    # double the load on the server for no benefit.
    running = read_json(PROGRESS_FILE, {})
    if index_running(running) and running.get("pid") != os.getpid():
        die("an index is already running", code=5)

    started = int(time.time())
    state = {"stage": "starting", "artists": 0, "artistTotal": 0,
             "tracks": 0, "trackTotal": 0, "startedAt": started,
             "pid": os.getpid()}

    def publish(**changes) -> None:
        """Say how far we have got, for the panel's live counts.

        Written on every page — a page is a second or two of work, which is
        the right granularity for a number a person is watching, and cheap
        next to the request that produced it.
        """
        state.update(changes)
        state["updatedAt"] = int(time.time())
        try:
            write_json(PROGRESS_FILE, state, mode=0o600)
        except Exception:
            pass          # progress is a nicety; never fail an index over it

    publish()
    plex = Plex()
    plex.resolve_base(force=True)
    if not read_json(SETTINGS_FILE, {}).get("musicSection"):
        plex.section = plex.find_music_section()
        plex.settings["musicSection"] = plex.section
        write_json(SETTINGS_FILE, plex.settings)

    publish(stage="artists")
    artists = plex.all_artists(
        on_progress=lambda n, total: publish(artists=n, artistTotal=total))
    write_json(ARTISTS_FILE, {
        "indexedAt": int(time.time()),
        "server": plex.base,
        "section": plex.section,
        "artists": artists,
    }, mode=0o644)

    publish(stage="tracks", artists=len(artists))
    tracks = plex.all_tracks(
        on_progress=lambda n, total: publish(tracks=n, trackTotal=total))
    write_json(TRACKS_FILE, {
        "indexedAt": int(time.time()),
        "server": plex.base,
        "section": plex.section,
        "tracks": tracks,
    }, mode=0o644)

    result = {"artistCount": len(artists), "trackCount": len(tracks),
              "trackTotal": getattr(plex, "track_total", 0),
              "trackSkipped": getattr(plex, "track_skipped", 0),
              "server": plex.base, "section": plex.section}
    publish(stage="done", artists=len(artists), tracks=len(tracks),
            finishedAt=int(time.time()))
    emit(result)


def cmd_progress(args) -> None:
    """How far the running index has got — polled by the panel while it runs.

    Deliberately its own tiny command: it reads one small file and never talks
    to Plex, so polling it every couple of seconds during a scan costs nothing.
    """
    state = read_json(PROGRESS_FILE, {}) or {}
    running = index_running(state)
    now = int(time.time())
    emit({
        "running": running,
        "stage": state.get("stage") or ("done" if state else "none"),
        "artists": bounded_int(state.get("artists")),
        "artistTotal": bounded_int(state.get("artistTotal")),
        "tracks": bounded_int(state.get("tracks")),
        "trackTotal": bounded_int(state.get("trackTotal")),
        "startedAt": bounded_int(state.get("startedAt")),
        "elapsed": (now - bounded_int(state.get("startedAt"))
                    if state.get("startedAt") else 0),
    })


def load_index() -> list[dict]:
    index = read_json(ARTISTS_FILE, None)
    if not index or not index.get("artists"):
        die("artist index is empty — run `plexmusic index` first")
    return index["artists"]


def cmd_search(args) -> None:
    query = fold(args.query.strip())
    if not query:
        emit({"results": []})
        return
    artists = load_index()
    starts, contains = [], []
    for a in artists:
        key = a.get("fold") or fold(a["title"])
        if key.startswith(query):
            starts.append(a)
        elif query in key:
            contains.append(a)
        if len(starts) >= args.limit:
            break
    results = (starts + contains)[: args.limit]
    emit({"results": results, "query": args.query})


def cmd_favourites(args) -> None:
    store = read_json(FAVOURITES_FILE, {"items": []})
    items = store.get("items", [])

    if args.action == "list":
        emit({"items": items})
        return

    if args.action == "add":
        if not args.key:
            die("favourites add needs --key")
        if any(i["key"] == args.key for i in items):
            emit({"items": items, "added": False})
            return
        title = args.title
        if not title:
            for a in load_index():
                if a["key"] == args.key:
                    title = a["title"]
                    break
        items.append({"key": args.key, "title": title or args.key})
        write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "added": True})
        return

    if args.action == "remove":
        items = [i for i in items if i["key"] != args.key]
        write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "removed": True})
        return

    if args.action == "move":
        # Reorder the curated list: move --key to --position (0-based).
        idx = next((n for n, i in enumerate(items) if i["key"] == args.key), None)
        if idx is None:
            die("that artist is not in favourites")
        item = items.pop(idx)
        pos = max(0, min(len(items), args.position))
        items.insert(pos, item)
        write_json(FAVOURITES_FILE, {"items": items})
        emit({"items": items, "moved": True})
        return

    die(f"unknown favourites action: {args.action}")


def cmd_albums(args) -> None:
    plex = Plex()
    plex.resolve_base()
    emit({"albums": plex.artist_albums(args.artist), "artistKey": args.artist})


def cmd_tracks(args) -> None:
    plex = Plex()
    plex.resolve_base()
    if args.album:
        tracks, source = plex.album_tracks(args.album), {"album": args.album}
    elif args.playlist:
        tracks, source = plex.playlist_tracks(args.playlist), {"playlist": args.playlist}
    elif args.artist:
        tracks, source = plex.artist_tracks(args.artist), {"artist": args.artist}
    else:
        die("tracks needs --album, --playlist or --artist")
    for t in tracks:
        t.pop("part", None)          # the token-bearing bit stays out of the UI
    plex.attach_art(tracks, 96, thumb_field="albumThumb")
    emit({"tracks": tracks, "source": source})


def cmd_playlists(args) -> None:
    plex = Plex()
    plex.resolve_base()
    if args.action == "list":
        emit({"playlists": plex.playlists()})
        return
    keys = [k for k in (args.tracks or "").split(",") if k.strip()]
    if args.action == "create":
        if not args.title:
            die("playlists create needs --title")
        created = plex.playlist_create(args.title.strip(), keys)
        emit({"created": created, "added": len(keys), "playlists": plex.playlists()})
        return
    if args.action == "add":
        if not args.key or not keys:
            die("playlists add needs --key and --tracks k1,k2")
        added = plex.playlist_add(args.key, keys)
        emit({"key": args.key, "added": added, "playlists": plex.playlists()})
        return
    die(f"unknown playlists action: {args.action}")


def cmd_play(args) -> None:
    plex = Plex()
    plex.resolve_base()
    if args.album:
        tracks, source = plex.album_tracks(args.album), {"album": args.album}
    elif args.playlist:
        tracks, source = plex.playlist_tracks(args.playlist), {"playlist": args.playlist}
    elif args.tracks:
        keys = [k for k in args.tracks.split(",") if k.strip()]
        tracks, source = plex.tracks_by_keys(keys), {"tracks": keys}
    elif args.key:
        tracks, source = plex.artist_tracks(args.key), {"artist": args.key}
    else:
        die("play needs --key (artist), --album, --playlist or --tracks")
    if not tracks:
        die("nothing playable there")

    # Start partway through an album or playlist without dropping what comes
    # before it: the needle then lands at the right groove and "previous" works.
    start_index = 0
    if args.start_at:
        for i, t in enumerate(tracks):
            if t["key"] == str(args.start_at):
                start_index = i
                break

    start_queue(plex, tracks, source, bool(args.shuffle), start_index, bool(args.loop))


def start_queue(plex, tracks, source, shuffle, start_index=0, loop=False) -> None:
    """Write the m3u + queue file for these tracks and hand them to mpv."""
    lines = ["#EXTM3U"]
    for t in tracks:
        seconds = int((t["duration"] or 0) / 1000)
        label = f"{t['artist']} - {t['title']}" if t["artist"] else t["title"]
        lines.append(f"#EXTINF:{seconds},{label}")
        lines.append(plex.stream_url(t["part"]))

    # The playlist embeds the Plex token in every URL — owner-only, and
    # written through the same no-follow atomic writer as the JSON files.
    atomic_write(PLAYLIST_FILE, ("\n".join(lines) + "\n").encode("utf-8"),
                 0o600)

    # `part` stays in the queue: with --shuffle mpv reorders its own playlist,
    # so the only reliable way to know what is playing is to match mpv's
    # current path back to a track. The file is 0600 for the same reason the
    # playlist is — these URLs carry the token.
    write_json(QUEUE_FILE, {
        "startedAt": int(time.time()),
        "source": source,
        "shuffle": shuffle,
        "tracks": tracks,
    })

    mpv_launch(PLAYLIST_FILE, shuffle=shuffle, start_index=start_index,
               loop=loop)
    # Warm the cover of the track that will sound first.
    first_art = None
    if tracks:
        first_art = plex.art_path(tracks[start_index].get("albumThumb", ""))
    emit({"trackCount": len(tracks), "source": source,
          "shuffle": shuffle, "art": first_art})


DECADES = [1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020]


def cmd_stations(args) -> None:
    """What the Stations tab can offer: decades with counts, styles, moods."""
    plex = Plex()
    plex.resolve_base()
    decades = []
    for d in DECADES:
        data = plex.get(f"/library/sections/{plex.section}/all",
                        {"type": 9, "decade": d, "X-Plex-Container-Start": 0,
                         "X-Plex-Container-Size": 1})
        c = data.get("MediaContainer", {})
        total = int(c.get("totalSize") or c.get("size") or 0)
        if total:
            decades.append({"decade": d, "label": f"{str(d)[2:]}s", "albums": total})

    def directory(kind):
        data = plex.get(f"/library/sections/{plex.section}/{kind}", {"type": 10})
        out = []
        for m in data.get("MediaContainer", {}).get("Directory", []) or []:
            if m.get("key") and m.get("title"):
                out.append({"key": str(m["key"]), "title": m["title"]})
        return out
    emit({"decades": decades, "styles": directory("genre"), "moods": directory("mood")})


def cmd_decades(args) -> None:
    """The 'Top albums from the 1970s' rows: a dozen albums per decade."""
    plex = Plex()
    plex.resolve_base()
    rows = []
    for d in DECADES:
        data = plex.get(f"/library/sections/{plex.section}/all",
                        {"type": 9, "decade": d, "sort": "lastViewedAt:desc",
                         "X-Plex-Container-Start": 0, "X-Plex-Container-Size": args.size})
        c = data.get("MediaContainer", {})
        albums = []
        for m in c.get("Metadata", []) or []:
            thumb = m.get("thumb") or m.get("parentThumb") or ""
            albums.append({"key": str(m.get("ratingKey")), "title": m.get("title") or "",
                           "artist": m.get("parentTitle") or "", "year": m.get("year") or 0,
                           "thumb": thumb})
        if albums:
            rows.append({"decade": d, "label": f"{str(d)[2:]}s", "albums": albums})
    plex.attach_art([a for r in rows for a in r["albums"]], 200)
    emit({"rows": rows})


def _random_tracks(plex, extra: dict, size: int) -> list[dict]:
    q = {"type": 10, "sort": "random", "X-Plex-Container-Start": 0,
         "X-Plex-Container-Size": size}
    q.update(extra)
    return plex.tracks_at(f"/library/sections/{plex.section}/all?" + urllib.parse.urlencode(q))


def _tracks_from_decade(plex, decade: int, albums: int, per_album: int) -> list[dict]:
    import random
    data = plex.get(f"/library/sections/{plex.section}/all",
                    {"type": 9, "decade": decade, "sort": "random",
                     "X-Plex-Container-Start": 0, "X-Plex-Container-Size": albums})
    out: list[dict] = []
    for m in data.get("MediaContainer", {}).get("Metadata", []) or []:
        tracks = plex.album_tracks(str(m.get("ratingKey")))
        random.shuffle(tracks)
        out.extend(tracks[:per_album])
    random.shuffle(out)
    return out


def cmd_station(args) -> None:
    """Build a radio queue the way Plexamp does — client side, from filters."""
    import random
    plex = Plex()
    plex.resolve_base()
    kind = args.kind
    size = args.size
    shuffle = False
    if kind == "library":
        tracks = _random_tracks(plex, {}, size)
    elif kind == "deepcuts":
        # Never-played tracks; the closest the server gets to 'deep cuts'.
        tracks = _random_tracks(plex, {"unwatched": 1}, size)
    elif kind == "randomalbum":
        data = plex.get(f"/library/sections/{plex.section}/all",
                        {"type": 9, "sort": "random", "X-Plex-Container-Start": 0,
                         "X-Plex-Container-Size": 4})
        tracks = []
        for m in data.get("MediaContainer", {}).get("Metadata", []) or []:
            tracks.extend(plex.album_tracks(str(m.get("ratingKey"))))
    elif kind == "decade":
        if not args.decade:
            die("decade station needs --decade 1970")
        tracks = _tracks_from_decade(plex, int(args.decade), albums=16, per_album=3)
    elif kind == "timetravel":
        tracks = []
        for d in DECADES:
            tracks.extend(_tracks_from_decade(plex, d, albums=3, per_album=2))
        random.shuffle(tracks)
    elif kind == "style":
        if not args.key:
            die("style station needs --key GENRE")
        tracks = _random_tracks(plex, {"genre": args.key}, size)
    elif kind == "mood":
        if not args.key:
            die("mood station needs --key MOOD")
        tracks = _random_tracks(plex, {"mood": args.key}, size)
    else:
        die(f"unknown station: {kind}")
    if not tracks:
        die("that station came up empty")
    start_queue(plex, tracks, {"station": kind, "decade": args.decade, "key": args.key},
                shuffle, 0, bool(args.loop))


def cmd_cmd(args) -> None:
    action = args.action
    if action == "play-pause":
        mpv_request(["cycle", "pause"])
    elif action == "play":
        mpv_request(["set_property", "pause", False])
    elif action == "pause":
        mpv_request(["set_property", "pause", True])
    elif action == "next":
        mpv_request(["playlist-next", "force"])
    elif action == "prev":
        # On the first track (or more than a few seconds in) "previous" means
        # the start of this track, as on every player; forcing playlist-prev
        # at the start of the queue makes mpv quit.
        pos = mpv_get("playlist-pos") or 0
        elapsed = mpv_get("time-pos") or 0
        if pos <= 0 or elapsed > 4:
            mpv_request(["seek", 0, "absolute"])
        else:
            mpv_request(["playlist-prev"])
    elif action == "stop":
        mpv_stop()
    elif action == "volume":
        if args.value is None:
            die("volume needs --value 0-130")
        mpv_request(["set_property", "volume", float(args.value)])
    elif action == "seek":
        if args.value is None:
            die("seek needs --value SECONDS (absolute)")
        mpv_request(["seek", float(args.value), "absolute"])
    elif action == "loop":
        # Repeat the whole queue when it ends. Takes effect on the running
        # player immediately.
        mpv_request(["set_property", "loop-playlist", "inf" if (args.value or 0) > 0 else "no"])
    else:
        die(f"unknown command: {action}")
    emit({"action": action})


def current_entry(queue: dict, path: str, pos) -> dict:
    """The queue entry mpv is playing, or {} when it cannot be told.

    Matched by the track's part key inside mpv's current path, which holds
    whether or not --shuffle reordered mpv's playlist. Only an unshuffled
    queue may fall back to the playlist position.
    """
    tracks = queue.get("tracks", []) or []
    if path:
        for track in tracks:
            if track.get("part") and track["part"] in path:
                return track
    if isinstance(pos, int) and not isinstance(pos, bool) and 0 <= pos < len(tracks) \
            and not queue.get("shuffle"):
        return tracks[pos]
    return {}


def cmd_now(args) -> None:
    if not mpv_running():
        emit({"playing": False})
        return
    pos = mpv_get("playlist-pos")
    queue = read_json(QUEUE_FILE, {})
    entry = current_entry(queue, mpv_get("path") or "", pos)

    # File tags are the truth for what is sounding; the queue fills the gaps
    # left by untagged rips.
    meta = mpv_get("metadata") or {}
    meta = {str(k).lower(): v for k, v in meta.items()} if isinstance(meta, dict) else {}

    art = None
    thumb = entry.get("albumThumb") or ""
    if thumb:
        cached = art_cache_path(thumb, 500)
        if os.path.exists(cached):
            art = cached
        elif not args.no_fetch:
            try:
                plex = Plex()
                plex.resolve_base()
                art = plex.art_path(thumb)
            except SystemExit:
                art = None

    emit({
        "playing": True,
        "paused": bool(mpv_get("pause")),
        "title": meta.get("title") or entry.get("title") or mpv_get("media-title") or "",
        "artist": meta.get("artist") or entry.get("artist") or "",
        "album": meta.get("album") or entry.get("album") or "",
        "art": art,
        "position": mpv_get("time-pos") or 0,
        "duration": mpv_get("duration") or 0,
        "volume": mpv_get("volume") or 0,
        "playlistPos": pos,
        "playlistCount": mpv_get("playlist-count") or 0,
        "shuffle": bool(queue.get("shuffle")),
        "loop": mpv_get("loop-playlist") in ("inf", "force", True),
        "key": entry.get("key") or "",
        "albumKey": entry.get("albumKey") or "",
        # Queues written before these fields existed simply leave them empty;
        # the panel then falls back to the artist, or does nothing.
        "artistKey": entry.get("artistKey") or "",
        "albumYear": entry.get("albumYear") or 0,
    })


# --------------------------------------------------------------------------- #

def main() -> None:
    parser = argparse.ArgumentParser(prog="plexmusic", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)

    p = sub.add_parser("link", help="link this machine to a Plex account")
    p.add_argument("action", choices=["start", "poll", "status", "forget"])
    p.set_defaults(func=cmd_link)

    p = sub.add_parser("server", help="list/add Plex addresses (incl. Tailscale)")
    p.add_argument("--add", metavar="URL",
                   help="a Plex address, e.g. a LAN host or a VPN address such "
                        "as http://100.64.0.10:32400 on a Tailscale tailnet")
    p.add_argument("--use", metavar="URL", help="add and pin this address")
    p.add_argument("--remove")
    p.set_defaults(func=cmd_server)

    sub.add_parser("account", help="who is linked").set_defaults(func=cmd_account)

    p = sub.add_parser("sections", help="music libraries on the server")
    p.add_argument("--use", metavar="KEY", help="index this library from now on")
    p.set_defaults(func=cmd_sections)

    p = sub.add_parser("art")
    p.add_argument("thumb", help="Plex thumb path from a track or artist")
    p.add_argument("--size", type=int, default=500)
    p.set_defaults(func=cmd_art)

    p = sub.add_parser("index")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_index)

    sub.add_parser("progress", help="how far a running index has got"
                   ).set_defaults(func=cmd_progress)

    p = sub.add_parser("search")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=60)
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("favourites")
    p.add_argument("action", choices=["list", "add", "remove", "move"])
    p.add_argument("--key")
    p.add_argument("--title")
    p.add_argument("--position", type=int, default=0)
    p.set_defaults(func=cmd_favourites)

    p = sub.add_parser("albums")
    p.add_argument("--artist", required=True)
    p.set_defaults(func=cmd_albums)

    p = sub.add_parser("tracks")
    p.add_argument("--album")
    p.add_argument("--playlist")
    p.add_argument("--artist")
    p.set_defaults(func=cmd_tracks)

    p = sub.add_parser("playlists", help="Plex playlists: list, create, add")
    p.add_argument("action", choices=["list", "create", "add"])
    p.add_argument("--key", help="playlist ratingKey (add)")
    p.add_argument("--title", help="new playlist title (create)")
    p.add_argument("--tracks", help="comma-separated track ratingKeys")
    p.set_defaults(func=cmd_playlists)

    sub.add_parser("stations", help="decades, styles and moods for the Stations tab").set_defaults(func=cmd_stations)

    p = sub.add_parser("decades", help="top albums per decade")
    p.add_argument("--size", type=int, default=12)
    p.set_defaults(func=cmd_decades)

    p = sub.add_parser("station", help="build and play a radio queue")
    p.add_argument("kind", choices=["library", "deepcuts", "randomalbum", "decade",
                                    "timetravel", "style", "mood"])
    p.add_argument("--decade", type=int)
    p.add_argument("--key", help="genre or mood key")
    p.add_argument("--size", type=int, default=100)
    p.add_argument("--loop", action="store_true")
    p.set_defaults(func=cmd_station)

    p = sub.add_parser("play")
    p.add_argument("--key", help="artist ratingKey")
    p.add_argument("--album", help="album ratingKey")
    p.add_argument("--playlist", help="playlist ratingKey")
    p.add_argument("--tracks", help="comma-separated track ratingKeys")
    p.add_argument("--start-at", help="track ratingKey to begin from")
    p.add_argument("--shuffle", action="store_true")
    p.add_argument("--loop", action="store_true", help="repeat the queue when it ends")
    p.set_defaults(func=cmd_play)

    p = sub.add_parser("cmd")
    p.add_argument("action", choices=["play-pause", "play", "pause", "next",
                                      "prev", "stop", "volume", "seek", "loop"])
    p.add_argument("--value", type=float)
    p.set_defaults(func=cmd_cmd)

    p = sub.add_parser("now")
    p.add_argument("--no-fetch", action="store_true",
                   help="use cached artwork only, never hit the server")
    p.set_defaults(func=cmd_now)

    args = parser.parse_args()
    try:
        args.func(args)
    except urllib.error.HTTPError as exc:
        die(f"Plex returned HTTP {exc.code} for {exc.url}")
    except urllib.error.URLError as exc:
        die(f"cannot reach Plex: {exc.reason}")
    except ResponseTooLarge as exc:
        die(f"refusing an oversized reply from Plex: {exc}", code=4)


if __name__ == "__main__":
    main()
